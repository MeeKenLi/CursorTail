<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CursorTail.Core">
    <Style TargetType="{x:Type local:ContentPanel}">
        <Style.Setters>
            <Setter Property="IsNextRow" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:ContentPanel}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="TitlePanel" Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource BodyTextBox}" Text="{TemplateBinding Title}"/>
                                <TextBlock Style="{DynamicResource CaptionTextBox}" Text="{TemplateBinding Subtitle}"/>
                            </StackPanel>
                            <ContentPresenter x:Name="ContPres" Grid.Column="1" Grid.Row="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsNextRow" Value="True">
                                <Setter TargetName="ContPres" Property="Grid.Column" Value="0"/>
                                <Setter TargetName="ContPres" Property="Grid.Row" Value="1"/>
                                <Setter TargetName="TitlePanel" Property="Margin" Value="0,0,0,8"/>
                            </Trigger>
                            <Trigger Property="IsNextRow" Value="False">
                                <Setter TargetName="ContPres" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="ContPres" Property="Grid.Row" Value="0"/>
                                <Setter TargetName="TitlePanel" Property="Margin" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
</ResourceDictionary>