<Application x:Class="CursorTail.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CursorTail">


    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <ResourceDictionary Source="/Core/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BodyTextBox" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="ExtraBold"/>
                <!--<Setter Property="Foreground" Value="{DynamicResource }"/>-->
            </Style>
            <Style x:Key="CaptionTextBox" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="12,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="ControlBorder" TargetType="Border">
                <Setter Property="Padding" Value="16"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            </Style>
            <Style x:Key="TitleTextBlock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="Margin" Value="0,32,0,24"/>
                <Setter Property="FontWeight" Value="Black"/>
            </Style>
            <Style x:Key="SubtitleTextBlock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FontWeight" Value="Black"/>
            </Style>
            <Style x:Key="HorizonSplitLine" TargetType="Rectangle">
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="-12,12"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
